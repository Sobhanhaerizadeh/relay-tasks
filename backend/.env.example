# Sicherheit
# Eine lange zufällige Zeichenkette zum Signieren von JWT-Tokens
SECRET_KEY=

# Datenbank
# Verbindungs-URL zur Datenbank (SQLite-Datei im Ordner backend)
# Leer lassen geht auch, dann wird automatisch relay.db benutzt
DATABASE_URL=sqlite:///./relay.db

# Frontend
# Die URL, unter der das Frontend läuft
# Beispiel: http://localhost:3000
FRONTEND_URL=

# Backend
# Der Port, auf dem FastAPI läuft
# Beispiel: 8000
BACKEND_PORT=
